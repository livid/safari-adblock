<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where the extension leaves its totals for the Shield app to show (see
	     SafariWebExtensionHandler.swift). The sandbox itself comes from the build settings. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>66KP7KX9MX.io.github.livid.Shield</string>
	</array>
</dict>
</plist>
