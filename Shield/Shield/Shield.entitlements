<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle installs updates through its own helper services; a sandboxed app has to be
	     allowed to reach them. The sandbox and network access themselves come from the
	     ENABLE_APP_SANDBOX and ENABLE_OUTGOING_NETWORK_CONNECTIONS build settings. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<!-- Where the Safari extension leaves the totals the window shows (see StatusView.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>66KP7KX9MX.io.github.livid.Shield</string>
	</array>
</dict>
</plist>
