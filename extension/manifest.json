{
  "manifest_version": 3,
  "name": "Shield – Ad & Threat Blocker",
  "version": "1.3.1",
  "description": "Blocks ads, trackers, cryptominers, and known malware and phishing sites.",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "18.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "privacy",
        "enabled": true,
        "path": "rules/privacy.json"
      },
      {
        "id": "annoyances",
        "enabled": true,
        "path": "rules/annoyances.json"
      },
      {
        "id": "threats",
        "enabled": true,
        "path": "rules/threats.json"
      }
    ]
  }
}
